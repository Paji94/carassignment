# `npm run generate-vapid-keys` で生成してください
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=mailto:you@example.com

# /api/cron/check を外部スケジューラから叩く場合の共有シークレット（任意）
CRON_SECRET=

# 運行情報の取得元（未設定時は既定のrti-giken鉄道遅延情報APIを使用）
DELAY_API_ENDPOINT=https://tetsudo.rti-giken.jp/free/delay.json

# 監視を休止する時間帯（小田急線の終電後〜始発前）
QUIET_HOURS_START=01:30
QUIET_HOURS_END=04:30

# 購読情報・状態を保存するJSONファイルの置き場所
DATA_DIR=./data
