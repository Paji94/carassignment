# `npm run generate-vapid-keys` で生成してください
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=mailto:you@example.com

# /api/cron/check を外部スケジューラから叩く場合の共有シークレット（任意）
CRON_SECRET=

# 公共交通オープンデータセンター（ODPT）のAPIキー。
# https://www.odpt.org / https://developer-dc.odpt.org でアカウント登録して取得（無料）
ODPT_CONSUMER_KEY=

# 通常は変更不要（ODPT側の仕様変更時のみ上書き）
# ODPT_API_BASE=https://api.odpt.org/api/v4/odpt:TrainInformation
# ODPT_OPERATOR=odpt.Operator:Odakyu
# ODPT_CONSUMER_KEY_PARAM=acl:consumerKey

# 監視を休止する時間帯（小田急線の終電後〜始発前）
QUIET_HOURS_START=01:30
QUIET_HOURS_END=04:30

# 購読情報・状態を保存するJSONファイルの置き場所
DATA_DIR=./data
