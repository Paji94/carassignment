{
  "name": "train-watch",
  "version": "1.0.0",
  "private": true,
  "description": "小田急線の遅延・運転見合わせをプッシュ通知でお知らせするアプリ",
  "scripts": {
    "dev": "cross-env NODE_ENV=development node server.js",
