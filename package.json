    "test": "vitest run",
    "generate-vapid-keys": "node scripts/generate-vapid-keys.mjs"
  },
  "dependencies": {
    "next": "15.5.24",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "node-cron": "4.6.0",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@types/web-push": "3.6.4",
    "cross-env": "7.0.3",
    "typescript": "5.5.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "postcss": "8.5.26"
  },
  "engines": {
    "node": ">=20"
  }
